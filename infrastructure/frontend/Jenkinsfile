// Frontend Terraform pipeline
pipeline {
    agent {
        label 'ecs2'
    }

    environment {
        TF_DIR = 'infrastructure/frontend'
        // Updated to match your ECS cluster region (Mumbai)
        AWS_DEFAULT_REGION = 'ap-south-1' 
        AWS_REGION = 'ap-south-1'
    }

    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/AnupDudhe/cdec-alpha-app.git', branch: 'main'
            }
        }

        stage('Terraform Operations') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-frontend-terraform',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    dir(env.TF_DIR) {
                        // Pass backend config during init
                        sh 'terraform init -input=false -backend-config=backend.hcl'
                        
                        sh 'terraform validate'
                        
                        sh 'terraform plan -input=false -var-file=terraform.tfvars -out=tfplan'
                        
                        // Apply the saved execution plan directly for safe & fast execution
                        sh 'terraform apply -input=false -auto-approve tfplan'
                    }
                }
            }
        }
    }

    post {
        always {
            // Clean up plan files to prevent leaking sensitive state
            dir(env.TF_DIR) {
                sh 'rm -f tfplan'
            }
        }
    }
}
